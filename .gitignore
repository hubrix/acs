/.bundle
/vendor/bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
*.log

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

# Local environment / secrets.
/config/database.yml
/config/app.yml
/config/deploy.yml
/config/master.key
/config/credentials/*.key
.env
.env.*

# Database dumps and imports.
/db/*.sqlite3
/db/*.sqlite3-*
/db/import/*
/db/backups/*

# Compiled assets.
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Editors and OS cruft.
.DS_Store
.idea/
.redcar/
.project
.sass-cache/
/node_modules

# Ignore key files for decrypting credentials and more.
/config/*.key

